#!/usr/bin/env sh
set -eu

repo_root=$(git rev-parse --show-toplevel) || exit 1

if ! command -v bash >/dev/null 2>&1; then
  echo "Pre-commit failed: bash is required for the staged secret scan." >&2
  exit 1
fi

if ! bash "$repo_root/scripts/scan-staged-secrets.sh"; then
  echo "Pre-commit failed: staged secret scan blocked the commit." >&2
  exit 1
fi

if ! git diff --cached --check >/dev/null 2>&1; then
  echo "Pre-commit failed: staged whitespace validation failed." >&2
  exit 1
fi
